-- CONFIG GETTER --
function getConfigValue(key)
  local value = ui_mcm.get(key)
  if value ~= nil then
    return value
  end
  return CONFIG_DEFAULTS[key]
end


-- EXPORTS --
_G.getConfigValue = getConfigValue
